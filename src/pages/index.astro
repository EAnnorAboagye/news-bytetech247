---
// Homepage (build plan Phase 6) — the layout speced in the "News Site
// Blueprint" artifact: Live Wire ticker, an asymmetric hero split
// (~57/43, wide lead + narrower second story) instead of one full-width
// block, a 4-up "Popular Now" grid, then one 3-up rail per category.
// Data-flow shape (sort/slice, AdSlot interleaving, itemListJsonLd,
// LCP-matched preloadImage) forked from bytetech247.com's index.astro;
// the grid CSS itself is new, not a port — bytetech247.com has no
// asymmetric hero or ticker to fork from.
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Center from "../components/layout/Center.astro";
import Stack from "../components/layout/Stack.astro";
import HeroTile from "../components/HeroTile.astro";
import PostCard from "../components/PostCard.astro";
import AdSlot from "../components/AdSlot.astro";
import Ticker from "../components/Ticker.astro";
import { CATEGORIES, CATEGORY_HOMEPAGE_AD_SLOT, siteConfig } from "../config";
import { itemListJsonLd, absoluteUrl } from "../lib/json-ld";

const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Ticker: the 6 most recent posts across every category, not scoped to
// any one section below — it's a "what's moving right now" strip, not
// a duplicate of Popular Now.
const tickerPosts = allPosts.slice(0, 6);

// Hero split: the single most recent post gets the wide lead slot, the
// next most recent gets the narrower second-lead slot. Popular Now then
// picks up from the 3rd post — no overlap between the hero split and
// Popular Now, same "continuous stream" reasoning bytetech247.com's own
// homepage uses between its hero and Popular section.
const [heroPost, secondPost, ...rest] = allPosts;
const popularPosts = rest.slice(0, 4);

// Same LCP-preload reasoning as bytetech247.com's homepage: point the
// preload hint at the exact asset HeroTile's own <Picture> requests
// (1200w AVIF), not the raw source.
const heroPreload = heroPost
  ? await getImage({
      src: heroPost.data.coverImage,
      width: 1200,
      format: "avif",
    })
  : undefined;

// The one genuinely non-overlapping "these N posts, in order" list on
// this page — the category rails below repeat many of the same posts
// under a different lens (by category, not recency), so listing those
// too would just duplicate entries rather than describe anything new.
const streamItemListJsonLd = itemListJsonLd(
  [heroPost, secondPost, ...popularPosts]
    .filter((post): post is NonNullable<typeof post> => Boolean(post))
    .map((post) => absoluteUrl(`/${post.data.category}/${post.id}/`)),
);
---

<BaseLayout jsonLd={streamItemListJsonLd} preloadImage={heroPreload?.src}>
  <Center gutter="0">
    <Stack space="10" class="homepage-sections">
      <AdSlot
        adSlot={siteConfig.adSlots.homepageHeader}
        size="banner"
        label="Advertisement"
      />

      <h1 class="sr-only">{siteConfig.title}</h1>

      <Ticker posts={tickerPosts} />

      {
        (heroPost || secondPost) && (
          <section aria-label="Top stories" class="homepage-hero-split">
            {heroPost && (
              <div class="homepage-hero-split__lead">
                <HeroTile post={heroPost} />
              </div>
            )}
            {secondPost && (
              <div class="homepage-hero-split__second">
                <PostCard post={secondPost} eager />
              </div>
            )}
          </section>
        )
      }

      <AdSlot
        adSlot={siteConfig.adSlots.homepageAfterHero}
        size="rectangle"
        label="Advertisement"
      />

      {
        popularPosts.length > 0 && (
          <section aria-label="Popular posts">
            <h2 class="section-heading">Popular Now</h2>
            <div class="homepage-popular-grid">
              {popularPosts.map((post, i) => (
                <PostCard post={post} eager={i < 2} />
              ))}
            </div>
          </section>
        )
      }

      <AdSlot
        adSlot={siteConfig.adSlots.homepageAfterPopularNow}
        size="rectangle"
        label="Advertisement"
      />

      {
        CATEGORIES.map((category, index) => {
          // 6 max per rail — a preview/entry point, not the full
          // archive. "View all" is what keeps every post in the
          // category reachable despite the cap (Phase 8's category
          // page).
          const categoryPosts = allPosts
            .filter((post) => post.data.category === category.slug)
            .slice(0, 6);
          const isLast = index === CATEGORIES.length - 1;
          return (
            <>
              <section aria-label={category.name}>
                <h2 class="section-heading">{category.name}</h2>
                {categoryPosts.length > 0 ? (
                  <>
                    <div class="homepage-rail-grid">
                      {categoryPosts.map((post) => (
                        <PostCard post={post} />
                      ))}
                    </div>
                    <a href={`/${category.slug}/`} class="homepage-view-all">
                      View all in {category.name} →
                    </a>
                  </>
                ) : (
                  <p>No posts yet in {category.name}.</p>
                )}
              </section>

              <AdSlot
                adSlot={
                  siteConfig.adSlots[CATEGORY_HOMEPAGE_AD_SLOT[category.slug]]
                }
                size="rectangle"
                label="Advertisement"
                class={isLast ? "homepage-last-ad" : undefined}
              />
            </>
          );
        })
      }
    </Stack>
  </Center>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Asymmetric ~57/43 split — a hand-written grid-template-columns, not
     the auto-fill Grid primitive: auto-fill's column count varies
     continuously with viewport width and can't stay gap-free against a
     fixed 2-cell ratio at every width (the exact bug bytetech247.com's
     own homepage hit once with its featured-card row). Stacks to one
     column below the tablet breakpoint. */
  .homepage-hero-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--spacing) * 4);
  }

  @media (min-width: 48rem) {
    .homepage-hero-split {
      grid-template-columns: 1.35fr 1fr;
      align-items: stretch;
    }

    .homepage-hero-split__second :global(.post-card-wrapper) {
      height: 100%;
    }
  }

  /* Popular Now: fixed 4-up at desktop, same reasoning as the hero split
     — a deliberate column count, not whatever auto-fill happens to
     land on. */
  .homepage-popular-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: calc(var(--spacing) * 4);
    margin-top: calc(var(--spacing) * 4);
  }

  @media (min-width: 64rem) {
    .homepage-popular-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Category rail: fixed 3-up at desktop (the Blueprint's "3 up per
     row" spec), 2-up tablet, single column mobile. */
  .homepage-rail-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--spacing) * 4);
    margin-top: calc(var(--spacing) * 4);
  }

  @media (min-width: 40rem) {
    .homepage-rail-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .homepage-rail-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .section-heading {
    font-size: var(--text-2xl);
    color: var(--color-fg);
  }

  .homepage-view-all {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    margin-top: calc(var(--spacing) * 3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .homepage-view-all:hover {
    text-decoration: underline;
  }

  :global(.homepage-last-ad) {
    margin-bottom: calc(var(--spacing) * 2);
  }

  @media (max-width: 48rem) {
    :global(.homepage-sections) {
      --stack-space: calc(var(--spacing) * 8);
    }
  }
</style>
