---
// Placeholder homepage. Replaced with the real homepage (ticker,
// asymmetric hero, Popular Now, category rails) in Phase 6 of the build
// plan. For now this proves BaseLayout, the two-tier header, the
// weighted footer, and the JSON-LD fork all compile and render
// together.
import BaseLayout from "../layouts/BaseLayout.astro";
import Stack from "../components/layout/Stack.astro";
import Grid from "../components/layout/Grid.astro";
import { CATEGORIES } from "../config";
---

<BaseLayout>
  <Stack space="6">
    <h1>ByteTech247 News</h1>
    <p>Scaffold in progress — Phase 3 core-shell check.</p>
    <Grid minItemWidth="10rem" space="3">
      {
        CATEGORIES.map((category) => (
          <div data-category={category.slug} class="category-swatch">
            {category.name}
          </div>
        ))
      }
    </Grid>
  </Stack>
</BaseLayout>

<style>
  .category-swatch {
    border-radius: 0.5rem;
    padding: 1rem;
    background-color: var(--card-accent);
    color: var(--color-accent-fg);
    font-family: var(--font-display);
  }
</style>
