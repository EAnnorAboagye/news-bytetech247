---
// Privacy policy (build plan Phase 11). Forked structurally from
// bytetech247.com's privacy.astro, but the "what this site collects"
// section is rewritten to describe this site's ACTUAL current state,
// not bytetech247.com's. analyticsId now holds this domain's real GA4
// property, so this page has to describe it honestly, same discipline
// as when it was empty and the page said so plainly.
// cloudflareBeaconToken is still "" (src/config.ts) — no Cloudflare Web
// Analytics site exists for this domain yet, so that one stays not-live.
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config";
const lastUpdated = "August 18, 2026";
---

<BaseLayout
  title={`Privacy Policy — ${siteConfig.name}`}
  description={`${siteConfig.name}'s privacy policy: what data is collected, how it's used, and which third-party services are involved.`}
  noindex
>
  <article class="legal">
    <h1>Privacy Policy</h1>
    <p class="legal__updated">Last updated: {lastUpdated}</p>

    <p>
      {siteConfig.name} is an independent news publication. This policy explains what
      happens when you read it.
    </p>

    <h2>What this site collects today</h2>
    <p>
      {siteConfig.name} runs{" "}
      <a href="https://www.google.com/adsense/start/" rel="noopener">
        Google AdSense
      </a>, which may set cookies and use device/browser data to serve ads. This
      site keeps ad personalization signals (Google's "ad_storage,"
      "ad_user_data," and "ad_personalization" consent categories) turned off by
      default for every visitor, so AdSense serves non-personalized ads only —
      it does not build an ad profile of you or use your data for interest-based
      targeting on this site.
    </p>
    <p>
      {siteConfig.name} also runs Google Analytics (GA4) to understand which stories
      and categories get read, using cookies and similar technology to record standard
      usage data — pages viewed, approximate location at the country/region level,
      referring site, device and browser type, and how long a visit lasts. This is
      aggregate traffic measurement, not ad personalization: the "analytics_storage"
      consent category is on by default, while "ad_storage," "ad_user_data," and "ad_personalization"
      stay off, the same as for AdSense above. Google's own handling of this data
      is covered by{" "}
      <a href="https://policies.google.com/privacy" rel="noopener">
        Google's privacy policy
      </a>, not this one.
    </p>
    <p>
      Server logs at the hosting layer (Cloudflare) may record standard
      technical data — IP address, user agent, requested URL, timestamp — the
      same way any web server does; {siteConfig.name} does not access or process these
      logs beyond normal operational troubleshooting. This site does not currently
      run Cloudflare Web Analytics or any tool beyond AdSense and Google Analytics
      — if that changes, this page will be updated first, before it goes live, naming
      exactly what it collects.
    </p>

    <h2>Third-party links</h2>
    <p>
      Stories on {siteConfig.name} link out to primary sources, official announcements,
      and other outlets' reporting. Once you follow an outbound link, that site's
      own privacy practices apply — this policy only covers {siteConfig.name} itself.
    </p>

    <h2>Your rights</h2>
    <p>
      For a question about what's collected, or a request related to it, reach
      out via the <a href="/contact/">Contact</a> page.
    </p>

    <h2>Governing law</h2>
    <p>
      {siteConfig.name} is operated from {siteConfig.jurisdiction}, and this
      policy is governed by the laws of {siteConfig.jurisdiction}. If you're
      located elsewhere and local law grants you additional data rights, this
      site's practices above still apply — reach out via the <a href="/contact/"
        >Contact</a
      > page with any request and it will be handled directly, rather than pointing
      you to a formal process that doesn't exist yet for a site this size.
    </p>

    <h2>Changes to this policy</h2>
    <p>
      This page will be updated whenever what {siteConfig.name} collects or how it's
      handled changes — the "Last updated" date above reflects the most recent revision.
    </p>

    <p class="legal__disclaimer">
      This page is provided for transparency and is not a substitute for legal
      advice.
    </p>
  </article>
</BaseLayout>
