---
// Ported verbatim from bytetech247.com. `href` is optional so this can
// render as a plain non-linking pill if a future call site doesn't yet
// have a /tag/ route to point to.
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;
const classes =
  "inline-flex items-center rounded-full border border-border bg-bg-subtle px-2 py-1 text-xs text-fg-muted";
---

{
  href ? (
    <a
      href={href}
      class:list={[classes, "hover:border-accent hover:text-fg", className]}
    >
      <slot />
    </a>
  ) : (
    <span class:list={[classes, className]}>
      <slot />
    </span>
  )
}
