---
// Two-tier header (build plan Phase 3): a thin UtilityStrip above this
// main nav bar — no bytetech247.com analog, see UtilityStrip.astro. The
// nav bar itself (logo, mobile toggle, PrimaryNav, search/theme actions)
// is a near-verbatim fork of bytetech247.com's Header.astro.
//
// Bar order, left to right: logo, mobile menu toggle (below 72rem —
// hidden above it, where PrimaryNav's horizontal variant renders inline
// instead), primary nav (>=72rem only), search, dark/light toggle.
import { getCollection } from "astro:content";
import { siteConfig } from "../config";
import { getTopTagsByCategory } from "../lib/taxonomy";
import PrimaryNav from "./PrimaryNav.astro";
import UtilityStrip from "./UtilityStrip.astro";

const posts = await getCollection("blog");
const topTagsByCategory = getTopTagsByCategory(posts);
---

<UtilityStrip />
<div class="site-header__sentinel" aria-hidden="true"></div>
<header class="site-header">
  <div class="site-header__bar">
    <a href="/" class="site-header__logo">
      <img
        src="/logo-mark.svg"
        alt={siteConfig.name}
        width="28"
        height="28"
        class="site-header__logo-mark"
      />
      {
        /* aria-hidden — the image's own alt above already gives this
           link its full accessible name, avoiding a double announcement
           for screen reader users. */
      }
      <span aria-hidden="true">{siteConfig.name}</span>
    </a>

    <details class="site-header__mobile-toggle">
      <summary aria-label="Open menu">
        <span aria-hidden="true">&#9776;</span>
      </summary>
      <nav aria-label="Primary" class="site-header__mobile-nav">
        <PrimaryNav topTagsByCategory={topTagsByCategory} variant="vertical" />
      </nav>
    </details>

    <nav aria-label="Primary" class="site-header__desktop-nav">
      <PrimaryNav topTagsByCategory={topTagsByCategory} variant="horizontal" />
    </nav>

    <div class="site-header__actions">
      <button
        type="button"
        class="site-header__action"
        data-command-palette-trigger
        aria-label="Search (Ctrl+K)"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
      <button
        type="button"
        class="site-header__action site-header__theme-toggle"
        data-theme-toggle
        aria-label="Toggle dark mode"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="site-header__theme-icon site-header__theme-icon--sun"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <line x1="12" y1="2" x2="12" y2="4"></line>
          <line x1="12" y1="20" x2="12" y2="22"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="2" y1="12" x2="4" y2="12"></line>
          <line x1="20" y1="12" x2="22" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="site-header__theme-icon site-header__theme-icon--moon"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header__sentinel {
    position: absolute;
    top: 0;
    height: 1px;
    width: 100%;
    pointer-events: none;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid transparent;
    background-color: var(--color-bg);
    transition:
      border-color var(--duration-base) var(--ease-out-expo),
      box-shadow var(--duration-base) var(--ease-out-expo);
  }

  .site-header--elevated {
    border-bottom-color: var(--color-border);
    box-shadow: var(--shadow-card);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    max-width: 72rem;
    margin-inline: auto;
    padding: var(--spacing) calc(var(--spacing) * 4);
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing) * 1.5);
    min-height: 24px;
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--color-fg);
    text-decoration: none;
  }

  .site-header__logo-mark {
    border-radius: 0.375rem;
    flex-shrink: 0;
  }

  .site-header__actions {
    display: flex;
    gap: calc(var(--spacing) * 2);
    margin-left: calc(var(--spacing) * 3);
  }

  .site-header__mobile-toggle {
    margin-left: auto;
  }

  @media (min-width: 72rem) {
    .site-header__actions {
      margin-left: auto;
    }
  }

  .site-header__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: calc(var(--spacing) * 5);
    height: calc(var(--spacing) * 5);
    flex-shrink: 0;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background: none;
    color: var(--color-fg-muted);
  }

  .site-header__action:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .site-header__theme-toggle {
    position: relative;
  }

  .site-header__theme-icon {
    position: absolute;
    transition:
      opacity var(--duration-base) var(--ease-out-expo),
      transform var(--duration-base) var(--ease-out-expo);
  }

  .site-header__theme-icon--moon {
    opacity: 0;
    transform: rotate(-90deg);
  }

  :root[data-theme="dark"] .site-header__theme-icon--sun {
    opacity: 0;
    transform: rotate(90deg);
  }

  :root[data-theme="dark"] .site-header__theme-icon--moon {
    opacity: 1;
    transform: rotate(0deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__theme-icon {
      transition: none;
    }
  }

  .site-header__mobile-toggle {
    display: none;
  }

  .site-header__mobile-toggle > summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: calc(var(--spacing) * 5);
    height: calc(var(--spacing) * 5);
    cursor: pointer;
    list-style: none;
  }

  .site-header__mobile-toggle > summary::-webkit-details-marker {
    display: none;
  }

  .site-header__mobile-nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    max-height: calc(100vh - 100%);
    overflow-y: auto;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    padding: calc(var(--spacing) * 4);
  }

  @media (max-width: 72rem) {
    .site-header__mobile-toggle {
      display: block;
    }

    .site-header__desktop-nav {
      display: none;
    }

    .site-header__action {
      width: 44px;
      height: 44px;
    }

    .site-header__actions {
      gap: calc(var(--spacing) * 1);
      margin-left: var(--spacing);
    }

    .site-header__mobile-toggle > summary {
      width: 44px;
      height: 44px;
    }

    .site-header__mobile-nav :global(.primary-nav__link),
    .site-header__mobile-nav :global(.primary-nav > li > details > summary),
    .site-header__mobile-nav :global(.primary-nav__panel a) {
      min-height: 44px;
    }
  }
</style>

<script>
  document.addEventListener("click", (event) => {
    const toggle = (event.target as HTMLElement).closest("[data-theme-toggle]");
    if (!toggle) return;

    const current = document.documentElement.getAttribute("data-theme");
    const next = current === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    localStorage.setItem("theme", next);
  });

  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    for (const details of document.querySelectorAll(
      ".site-header details[open]",
    )) {
      if (!details.contains(target)) {
        details.removeAttribute("open");
      }
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    for (const details of document.querySelectorAll(
      ".site-header details[open]",
    )) {
      details.removeAttribute("open");
    }
  });

  let headerElevationObserver: IntersectionObserver | null = null;

  function setupHeaderElevation() {
    headerElevationObserver?.disconnect();

    const sentinel = document.querySelector(".site-header__sentinel");
    const header = document.querySelector(".site-header");
    if (!sentinel || !header) return;

    headerElevationObserver = new IntersectionObserver(
      ([entry]) => {
        header.classList.toggle("site-header--elevated", !entry.isIntersecting);
      },
      { threshold: 0 },
    );
    headerElevationObserver.observe(sentinel);
  }

  document.addEventListener("astro:page-load", setupHeaderElevation);

  const hoverCapable = window.matchMedia("(hover: hover) and (pointer: fine)");
  const hoverNavCloseTimers: WeakMap<
    Element,
    ReturnType<typeof setTimeout>
  > = new WeakMap();

  function setupHoverNav() {
    if (!hoverCapable.matches) return;

    for (const li of document.querySelectorAll(
      ".primary-nav--horizontal > li",
    )) {
      const details = li.querySelector(":scope > details");
      const summary = details?.querySelector(":scope > summary");
      if (!details || !summary) continue;

      li.addEventListener("mouseenter", () => {
        const pending = hoverNavCloseTimers.get(li);
        if (pending) clearTimeout(pending);
        details.setAttribute("open", "");
      });

      li.addEventListener("mouseleave", () => {
        const timer = setTimeout(() => details.removeAttribute("open"), 150);
        hoverNavCloseTimers.set(li, timer);
      });

      summary.addEventListener("click", (event) => {
        if (details.hasAttribute("open")) event.preventDefault();
      });
    }
  }

  document.addEventListener("astro:page-load", setupHoverNav);
</script>
