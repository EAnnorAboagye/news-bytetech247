---
// Terms & Conditions (build plan Phase 11). Forked from
// bytetech247.com's terms.astro — same jurisdiction (same operator),
// content-scope paragraph rewritten for news reporting rather than
// technical guides, no affiliate-disclosure cross-reference (that page
// isn't ported — see /about/'s "Ownership & funding" section instead).
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config";
const lastUpdated = "August 18, 2026";
---

<BaseLayout
  title={`Terms & Conditions — ${siteConfig.name}`}
  description={`${siteConfig.name}'s terms and conditions for using this site.`}
  noindex
>
  <article class="legal">
    <h1>Terms &amp; Conditions</h1>
    <p class="legal__updated">Last updated: {lastUpdated}</p>

    <p>
      These terms cover your use of {siteConfig.name} ({siteConfig.url}). By
      reading or using this site, you agree to them.
    </p>

    <h2>Content is news reporting, not professional advice</h2>
    <p>
      Stories on {siteConfig.name} cover developments in AI, software, consumer electronics,
      automotive tech, big tech, and startups — reported as accurately as possible
      at the time of publication. Facts, figures, and details reported here reflect
      what was known and sourced at publish time; where something is later confirmed
      wrong, see the <a href="/editorial-policy/">Editorial Policy</a>{" "}
      for how corrections are handled. Nothing on {siteConfig.name}{" "}
      constitutes financial, legal, or professional advice; verify anything you plan
      to act on against a primary source.{" "}
      {siteConfig.name} is not liable for outcomes from relying on content published
      here.
    </p>

    <h2>Intellectual property</h2>
    <p>
      Unless otherwise noted, written content and original graphics on
      {siteConfig.name} are the author's own work. Short excerpts may be quoted with
      attribution and a link back to the original story. Full-article republishing
      requires permission — reach out via the{" "}
      <a href="/contact/">Contact</a> page.
    </p>

    <h2>Third-party names and trademarks</h2>
    <p>
      Company names, product names, logos, and brands mentioned on{" "}
      {siteConfig.name} belong to their respective owners and are referenced for identification
      and reporting purposes only. Mentioning a company or product does not imply
      endorsement by its owner, and does not imply {siteConfig.name} endorses it beyond
      what's written in the story itself.
    </p>

    <h2>Comments and community content</h2>
    <p>
      If commenting is enabled on a story (via Giscus, backed by GitHub
      Discussions), you're responsible for what you post. Comments that are
      abusive, spam, or unrelated to the story may be removed. Comment hosting
      and moderation tooling is provided by GitHub, subject to GitHub's own
      terms.
    </p>

    <h2>Governing law</h2>
    <p>
      {siteConfig.name} is operated from {siteConfig.jurisdiction}, and these
      terms are governed by the laws of {siteConfig.jurisdiction}, without
      regard to conflict-of-law principles. Any dispute arising from your use of
      this site is subject to the jurisdiction of the courts of {
        siteConfig.jurisdiction
      }.
    </p>

    <h2>Changes</h2>
    <p>
      These terms may be updated as the site grows — see{" "}
      <a href="/about/">About</a> for the site's current ownership and funding status.
      The "Last updated" date above reflects the most recent revision.
    </p>

    <p class="legal__disclaimer">
      This page is provided for transparency and is not a substitute for legal
      advice.
    </p>
  </article>
</BaseLayout>
