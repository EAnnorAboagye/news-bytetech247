---
// Ported verbatim from bytetech247.com — fully category-agnostic (reads
// post.data.category + getCategoryName()), so 6 categories instead of 4
// is a zero-code-change scaling.
//
// coverImage is required by content.config.ts's schema; this renders it
// as the card's 16:9 image, the exact same asset used as the article's
// own hero image, never a different homepage-only thumbnail.
//
// `eager` defaults to false (lazy) — most PostCard instances are below
// the fold. index.astro passes eager={true} for above-the-fold grids
// specifically (Phase 6).
//
// Title and description are clamped to a fixed number of lines so cards
// in the same row stay level regardless of how long any one post's
// title/description is.
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Card from "./Card.astro";
import { getCategoryName } from "../config";

interface Props {
  post: CollectionEntry<"blog">;
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const categoryName = getCategoryName(post.data.category);
const href = `/${post.data.category}/${post.id}/`;
---

<div class="post-card-wrapper" data-category={post.data.category}>
  <Card as="article" padding="none" class="post-card">
    <a href={href} class="post-card__link">
      <div class="post-card__cover-wrap">
        <Picture
          src={post.data.coverImage}
          alt={post.data.coverImageAlt}
          widths={[640]}
          formats={["avif", "webp"]}
          loading={eager ? "eager" : "lazy"}
          class="post-card__cover"
        />
        <span class="post-card__badge">{categoryName}</span>
      </div>
      <div class="post-card__body">
        <h3 class="post-card__title">{post.data.title}</h3>
        <p class="post-card__description">{post.data.description}</p>
        <p class="post-card__meta">
          <time datetime={post.data.date.toISOString()}>
            {
              post.data.date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
                timeZone: "UTC",
              })
            }
          </time>
          <span class="post-card__read-more">Read more →</span>
        </p>
      </div>
    </a>
  </Card>
</div>

<style>
  .post-card-wrapper {
    height: 100%;
  }

  /*
   * :global() — .post-card is the class Card.astro (a *child* component)
   * actually renders its <article> with, via the `class` prop. Astro's
   * scoped-style attribute only ever lands on elements a component
   * writes directly in its own template, never on a child component's
   * internal output.
   */
  :global(.post-card) {
    height: 100%;
    position: relative;
  }

  /* A 3px category-colored top edge — the fastest way to tell categories
     apart in a mixed grid before reading any text. */
  :global(.post-card::before) {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background-color: var(--card-accent, var(--color-accent));
  }

  .post-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .post-card__cover-wrap {
    position: relative;
  }

  .post-card__cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* A solid category-colored badge directly on the thumbnail — puts the
     one piece of real per-card color where the eye actually lands
     first, instead of only in a small text label below the fold of the
     image. */
  .post-card__badge {
    position: absolute;
    top: calc(var(--spacing) * 1.5);
    left: calc(var(--spacing) * 1.5);
    padding: calc(var(--spacing) * 0.5) calc(var(--spacing) * 1.25);
    border-radius: 999px;
    background-color: var(--card-accent, var(--color-accent));
    color: var(--color-accent-fg);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
  }

  .post-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 1.5);
    padding: calc(var(--spacing) * 3);
  }

  .post-card__title {
    font-size: var(--text-lg);
    font-family: var(--font-serif);
    letter-spacing: normal;
    color: var(--color-fg);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__description {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__meta {
    margin-top: auto;
    padding-top: calc(var(--spacing) * 1);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing);
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
  }

  .post-card__read-more {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  .post-card__link:hover .post-card__read-more {
    text-decoration: underline;
  }
</style>
